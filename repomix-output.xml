/* --- モーダル改善 --- */

/* 画像上のお気に入りアイコン */
.card-img-container {
    position: relative;
    width: 100px;
    height: 133px;
    flex-shrink: 0;
}
.card-fav-overlay {
    position: absolute;
    top: 5px;
    left: 5px;
    font-size: 1.2rem;
    color: #ec4899;

        overflow: visible !important;
        text-overflow: clip !important;
        margin-bottom: 2px !important;
        display: block;
        text-align: center;
    }
    .stat-input-row {
        flex-direction: column !important; /* 枠の潰れ防止のため常に縦並び */
        gap: 1px !important;
    }
